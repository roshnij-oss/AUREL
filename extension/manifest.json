{
  "manifest_version": 3,
  "name": "AUREL",
  "version": "1.2.0",
  "description": "Browser-level phishing protection. Analyses page URLs only, through AUREL running on your own computer.",
  "permissions": ["tabs", "notifications", "storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
